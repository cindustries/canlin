# Generic / Universal ignore rules

# IDE & Editors
.vscode/
.idea/
.history/
*.code-workspace
*.swp
*.swo
*.bak
*.old

# OS
.DS_Store
Thumbs.db

# Environment
.env
.envrc

# Claude Code — commit: skills/, agents/, rules/, hooks/, settings.json
# Ignore: local overrides, credentials, session data

# Tracked: shared config & extensibility
!/.claude/
.claude/*
!.claude/settings.json
!.claude/settings.local.json
!.claude/agents/
!.claude/agents/**
!.claude/rules/
!.claude/rules/**
!.claude/skills/
!.claude/skills/**
!.claude/hooks/
!.claude/hooks/**

# Local overrides (machine-specific)
.claude/*.local.*
.claude/local/

# Credentials & session state (never track)
.claude/.credentials.json
.claude/statsig/
.claude/todos/
.claude/projects/

# karr materialized task view -- never commit
tasks/
config.yml

# build
*.o
*.a
build/
/canlin
/canlin-i686
