#!/usr/bin/env python3
"""Lane guard for the canlin-vendor agent (hooks in .claude/agents/canlin-vendor.md).

pre  — PreToolUse: Edit/Write only inside the vendoring paths; Bash without git
       history writes and without karr mutations except the worker's own note,
       block reason and handoff on its card.
stop — Stop: every changed path in the working tree must be a vendoring path.
Exit 2 blocks the call (or the stop) and hands stderr back to the agent.
"""
import json, os, re, shlex, subprocess, sys

def allowed(rel):
    rel = rel.replace(os.sep, "/")
    if rel == "docs/THIRD-PARTY.md":
        return True
    if re.match(r"(third_party|libs)/[^/]+/", rel):
        return True
    m = re.fullmatch(r"mk/([a-z0-9_-]+)\.mk", rel)
    if m:
        name = m.group(1)
        return any(os.path.isdir(os.path.join(ROOT, d, name))
                   for d in ("third_party", "libs"))
    return bool(re.fullmatch(r"src/[a-z0-9_]+/canlin_[a-z0-9_]+_config\.h", rel))

GIT_WRITES = {"commit", "push", "reset", "checkout", "switch", "restore", "rebase",
              "merge", "tag", "stash", "clean", "am", "apply", "cherry-pick", "revert"}

def git_subcommands(cmd):
    """The subcommand of every git call in a shell line: the first word after git and
    its global options. Flags and revisions (--no-checkout, v20^{commit}) never count."""
    for seg in re.split(r"\|\|?|&&|;|&|\n|\$\(|`|[()]", cmd):
        try:
            toks = shlex.split(seg)
        except ValueError:
            toks = seg.split()
        for i, t in enumerate(toks):
            if os.path.basename(t) != "git":
                continue
            j = i + 1
            while j < len(toks) and toks[j].startswith("-"):
                j += 2 if toks[j] in ("-C", "-c", "--git-dir", "--work-tree") else 1
            if j < len(toks):
                yield toks[j]

def block(msg):
    sys.stderr.write("canlin-vendor lane: " + msg + "\n")
    sys.exit(2)

# karr flags that take a value: they consume the next token, so a note that starts
# with a dash is a value and not a flag.
KARR_VALUE_FLAGS = {"-a", "--note", "--block", "-b", "--status", "--claim",
                    "--priority", "--tags", "--body", "--title", "--reason",
                    "-t", "--to", "--from", "--release"}
# What the house rules ask of the worker: note its progress on its card, block it
# with a reason, hand it over. Everything else on the board is the dispatcher's.
KARR_EDIT_OK = {"-a", "--note", "--block", "-b"}
# Read-only: they change nothing on the board.
KARR_READ_OK = {"list", "show", "board", "help", "version", "log", "diff"}

def karr_calls(cmd):
    """Every karr invocation in a shell line: (subcommand, flag keys)."""
    for seg in re.split(r"\|\|?|&&|;|&|\n|\$\(|`|[()]", cmd):
        try:
            toks = shlex.split(seg)
        except ValueError:
            toks = seg.split()
        for i, t in enumerate(toks):
            if os.path.basename(t) != "karr":
                continue
            rest = toks[i + 1:]
            if not rest:
                continue
            sub, rest = rest[0], rest[1:]
            flags, j = [], 0
            while j < len(rest):
                tok = rest[j]
                if not tok.startswith("-"):
                    j += 1
                    continue
                key = tok.split("=", 1)[0]
                flags.append(key)
                j += 1
                if key in KARR_VALUE_FLAGS and j < len(rest):
                    j += 1  # the value belongs to the flag
            yield sub, flags

def karr_allowed(sub, flags):
    if sub in KARR_READ_OK:
        return True
    if sub == "handoff":
        return True
    if sub == "edit":
        return all(f in KARR_EDIT_OK for f in flags)
    return False

data = json.load(sys.stdin)
ROOT = data.get("cwd") or os.getcwd()
top = subprocess.run(["git", "-C", ROOT, "rev-parse", "--show-toplevel"],
                     capture_output=True, text=True)
if top.returncode == 0:
    ROOT = top.stdout.strip()
mode = sys.argv[1] if len(sys.argv) > 1 else "pre"

if mode == "pre":
    tool = data.get("tool_name", "")
    inp = data.get("tool_input", {}) or {}
    if tool in ("Edit", "Write", "NotebookEdit"):
        path = inp.get("file_path") or inp.get("notebook_path") or ""
        rel = os.path.relpath(os.path.realpath(path), os.path.realpath(ROOT))
        if rel.startswith(".."):
            sys.exit(0)  # scratchpad and other paths outside the repo
        if not allowed(rel):
            block(f"{rel} is outside the vendoring paths (third_party/<lib>/, libs/<lib>/, "
                  "mk/<lib>.mk, docs/THIRD-PARTY.md, "
                  "src/<dir>/canlin_<lib>_config.h). Report it instead.")
    elif tool == "Bash":
        cmd = inp.get("command", "")
        bad = sorted(set(git_subcommands(cmd)) & GIT_WRITES)
        if bad:
            block(f"git {bad[0]}: git history and working-tree resets belong to the dispatcher.")
        bad = [(s, f) for s, f in karr_calls(cmd) if not karr_allowed(s, f)]
        if bad:
            sub, flags = bad[0]
            block(f"karr {sub}: board mutations belong to the dispatcher; the worker may "
                  "note, block and hand over its own card, nothing else.")
    sys.exit(0)

if mode == "stop":
    # Block at most once per agent run: stop_hook_active is not documented for
    # subagents, so a marker in the git dir keeps a foreign dirty path from looping.
    gd = subprocess.run(["git", "-C", ROOT, "rev-parse", "--absolute-git-dir"],
                        capture_output=True, text=True).stdout.strip()
    key = re.sub(r"[^A-Za-z0-9_-]", "", str(data.get("agent_id") or data.get("session_id") or ""))
    marker = os.path.join(gd, "canlin-vendor-stop-" + key) if gd and key else ""
    if data.get("stop_hook_active") or (marker and os.path.exists(marker)):
        sys.exit(0)
    st = subprocess.run(["git", "-C", ROOT, "status", "--porcelain", "-uall"],
                        capture_output=True, text=True)
    bad = []
    for line in st.stdout.splitlines():
        path = line[3:].split(" -> ")[-1].strip('"')
        if not allowed(path):
            bad.append(path)
    if bad:
        if marker:
            open(marker, "w").close()
        block("changed paths outside the vendoring lane: " + ", ".join(bad) +
              ". Undo your own changes there (you may not use git for it) or, if they "
              "were not yours, name them in the report.")
    sys.exit(0)
